      "dokploy_url": "https://dokploy.example.com",
      "dokploy_api_key": "dk_your_api_key_here",
      "github_provider_id": "",
      "added_at": "2026-02-17T12:00:00Z",

      "_comment_nodes": "Optional. If this panel manages extra nodes (Dokploy remote servers under one control plane), list them here. Placement policy: references/server-placement.md. Target a node by setting serverId in API bodies (null = this panel host).",
      "nodes": {
        "A": {
          "ip": "45.55.67.89",
          "server_id": null,
          "role": "control-plane (panel) + light web apps",
          "note": "panel host; keep RAM headroom for the control plane"
        },
        "B": {
          "ip": "45.55.67.90",
